<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NET_MAUI_App.Pages.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="12" MaximumWidthRequest="420">
            <Image Source="logo.png" HeightRequest="110" WidthRequest="110" Aspect="AspectFit"
                   SemanticProperties.Description="Logo von Roger Restaurant" />
            <Label Text="Roger Restaurant" FontSize="23" FontAttributes="Bold" TextColor="#172033"
                   HorizontalTextAlignment="Center" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Bern" FontSize="13" TextColor="#64748B" HorizontalTextAlignment="Center" />

            <Label Text="Anmeldung" Margin="0,20,0,0" FontSize="20" FontAttributes="Bold" TextColor="#172033" />
            <Label Text="Benutzername" FontSize="14" TextColor="#172033" />
            <Entry x:Name="EmailEntry" Placeholder="Deine E-Mail-Adresse" Keyboard="Email"
                   FontSize="16" TextColor="#172033" PlaceholderColor="#6B7280" BackgroundColor="White"
                   SemanticProperties.Description="E-Mail-Adresse" />
            <Label x:Name="EmailError" Text="Bitte gib deine E-Mail-Adresse ein." TextColor="Red" IsVisible="False" />
            <Label Text="Passwort" FontSize="14" TextColor="#172033" />
            <Entry x:Name="PasswordEntry" Placeholder="Dein Passwort" IsPassword="True"
                   FontSize="16" TextColor="#172033" PlaceholderColor="#6B7280" BackgroundColor="White"
                   SemanticProperties.Description="Passwort" />
            <Label x:Name="PasswordError" Text="Bitte gib dein Passwort ein." TextColor="Red" IsVisible="False" />
            <Label x:Name="LoginError" TextColor="Red" IsVisible="False" />

            <Button x:Name="LoginButton" Text="Anmelden" Clicked="OnLoginClicked"
                    BackgroundColor="#2563EB" TextColor="White" FontSize="15" />
            <Button x:Name="CreateAccountButton" Text="Neues Konto erstellen" Clicked="OnRegisterClicked"
                    BackgroundColor="Transparent" TextColor="#2563EB" FontSize="14" />


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
